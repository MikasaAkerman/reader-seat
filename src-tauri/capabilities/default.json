{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "书友席默认权限：HTTP 仅放行 DeepSeek；文件系统限 App 数据目录与下载目录",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.deepseek.com/*" }]
    },
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }]
    }
  ]
}
